# Copy to .env and adjust as needed.
# The LLM client is a single OpenAI-compatible client — point it at Ollama
# (default) or at OpenAI's API by changing these three values together.

# Local Ollama (default): any OpenAI-compatible local model server works.
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5-coder:latest
OPENAI_BASE_URL=http://localhost:11434/v1

# --- Or, to use OpenAI directly, comment the above and use: ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

LLM_MAX_TOKENS=4096

# --- Agent behavior caps ---
MAX_FILES_TO_SUMMARIZE=40
MAX_FILE_BYTES_FOR_CONTEXT=20000
MAX_VERIFICATION_RETRIES=3
COMMAND_TIMEOUT_SECONDS=180
